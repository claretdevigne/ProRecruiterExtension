{
  "manifest_version": 3,
  "name": "ProRecruiter - Extension",
  "version": "1.0",
  "description": "Asistente inteligente para scraping y análisis de compatibilidad en LinkedIn.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.google.com/*",
    "https://www.linkedin.com/*",
    "https://*.generativelanguage.googleapis.com/*",
    "https://script.google.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.google.com/*",
        "https://www.google.com/search*",
        "https://www.linkedin.com/in/*"
      ],
      "js": ["compromise.min.js", "content.js"],
      "css": ["styles.css"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}